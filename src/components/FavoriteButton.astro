---
import { starSvgHtml } from '../lib/cards';
import { translator } from '../lib/i18n';

interface Props {
  stopId: string;
  stopName: string;
}

const { stopId, stopName } = Astro.props;
const tr = translator(Astro.locals.locale ?? 'es');
---

{/* Tres tallas según dónde vive: en móvil cuadrado de 44px al lado del título (la losa no da
    para etiqueta), desde sm con etiqueta, y en lg a todo el ancho del raíl derecho de la losa.
    El icono lo cambia el CSS (group-aria-pressed); el script solo toca texto y estado. */}
<button
  id="fav-btn"
  type="button"
  data-stop-id={stopId}
  data-stop-name={stopName}
  aria-label={tr('fav.saveAria')}
  aria-pressed="false"
  class="group inline-flex h-11 w-11 shrink-0 items-center justify-center gap-2 rounded-lg border border-control-edge bg-surface text-sm font-semibold text-ink shadow-xs transition hover:bg-surface-2 active:bg-surface-2 aria-pressed:border-warn aria-pressed:bg-warn-soft aria-pressed:text-warn-ink focus-ring sm:w-auto sm:px-4 lg:w-full"
  title={tr('fav.saveTitle')}
>
  <span class="text-ink-3 group-aria-pressed:hidden" set:html={starSvgHtml(false, 'size-[18px]', 1.5)} />
  <span class="hidden group-aria-pressed:block" set:html={starSvgHtml(true, 'size-[18px]', 1.5)} />
  <span data-fav-label class="hidden sm:inline">{tr('fav.save')}</span>
</button>
<p id="fav-feedback" class="sr-only" role="status"></p>

<script>
  import { addFavorite, getFavorite, removeFavorite } from '../lib/favorites';
  import { clientLocale, t } from '../lib/i18n';

  const locale = clientLocale();
  const btn = document.getElementById('fav-btn') as HTMLButtonElement | null;
  const feedback = document.getElementById('fav-feedback');

  if (btn) {
    const stopId = btn.dataset.stopId ?? '';
    const label = btn.querySelector('[data-fav-label]');

    // OJO: nunca btn.textContent aquí — borraría los dos SVG de la estrella
    const render = (active: boolean): void => {
      btn.setAttribute('aria-pressed', String(active));
      btn.title = active ? t(locale, 'fav.removeTitle') : t(locale, 'fav.saveTitle');
      btn.setAttribute('aria-label', active ? t(locale, 'fav.removeAria') : t(locale, 'fav.saveAria'));
      if (label) label.textContent = active ? t(locale, 'fav.saved') : t(locale, 'fav.save');
    };

    // Notifica el estado (inicial y tras cada toggle) para que FavoriteLines active/desactive los chips
    const setState = (active: boolean): void => {
      render(active);
      window.dispatchEvent(new CustomEvent('favorite:state', { detail: { stopId, active } }));
    };

    void getFavorite(stopId).then((fav) => setState(!!fav));

    btn.addEventListener('click', async () => {
      const active = btn.getAttribute('aria-pressed') === 'true';
      try {
        if (active) {
          await removeFavorite(stopId);
          setState(false);
          if (feedback) feedback.textContent = t(locale, 'fav.removedMsg');
        } else {
          const stopName = btn.dataset.stopName ?? '';
          await addFavorite({ stopId, name: stopName });
          setState(true);
          if (feedback) feedback.textContent = t(locale, 'fav.addedMsg');
        }
      } catch (e) {
        if (feedback) feedback.textContent = e instanceof Error ? e.message : t(locale, 'fav.updateError');
      }
    });
  }
</script>
