---
// Página "sin conexión" compartida: la sirven las prerenderizadas /offline y /en/offline
import Layout from '../layouts/Layout.astro';
import { translator } from '../lib/i18n';

const locale = Astro.locals.locale ?? 'es';
const tr = translator(locale);
---

<Layout title={tr('offline.title')}>
  <section class="mx-auto max-w-md py-10 text-center">
    <p class="mx-auto grid size-14 place-items-center rounded-full bg-warn-soft text-2xl text-warn" aria-hidden="true">⚠</p>
    <h1 class="mt-4 text-2xl font-bold tracking-tight">{tr('offline.heading')}</h1>
    <p class="mt-2 text-ink-2 text-pretty">
      {tr('offline.body')}
    </p>
    <button
      type="button"
      id="retry-btn"
      class="mt-6 rounded-md bg-brand px-5 py-2.5 font-semibold text-on-brand shadow-xs transition hover:bg-brand-hover active:bg-brand-active focus-ring">{tr('error.retry')}</button
    >
  </section>
</Layout>

<script>
  document.getElementById('retry-btn')?.addEventListener('click', () => window.location.reload());
</script>
