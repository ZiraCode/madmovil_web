---
import type { LineIncident } from '../types/api';
import { cleanCauseText, incidentDateRange, incidentStatus, stripHtml } from '../lib/incidents';
import { href, t, translator } from '../lib/i18n';
import { safeExternalUrl } from '../lib/url';

interface Props {
  incident: LineIncident;
  now: number;
}

const { incident, now } = Astro.props;
const locale = Astro.locals.locale ?? 'es';
const tr = translator(locale);
const status = incidentStatus(incident, now);
const cause = cleanCauseText(incident.cause);
const effect = cleanCauseText(incident.effect);
const docUrl = safeExternalUrl(incident.documentUrl);
const published = incident.publishedAt ? new Date(incident.publishedAt) : null;
const publishedLabel =
  published && !Number.isNaN(published.getTime())
    ? new Intl.DateTimeFormat(locale === 'en' ? 'en-GB' : 'es-ES', {
        day: 'numeric',
        month: 'short',
        year: 'numeric',
        timeZone: 'Europe/Madrid',
      }).format(published)
    : null;
---

<li class="px-4 py-4 sm:px-5">
  <div class="flex flex-wrap items-center gap-x-2 gap-y-1.5">
    <span
      class:list={[
        'rounded-full px-2.5 py-0.5 text-xs font-semibold',
        status === 'active' ? 'bg-warn-soft text-warn-ink' : 'bg-surface-2 text-ink-2',
      ]}
    >
      {status === 'active' ? tr('incident.active') : tr('incident.upcoming')}
    </span>
    {incident.lines.map((l) => (
      <a
        href={href(`/incidencias?linea=${encodeURIComponent(l)}`, locale)}
        class="rounded border border-control-edge bg-surface-2 px-1.5 py-0.5 text-xs font-bold text-ink-2 transition hover:text-ink focus-ring"
      >
        {l}
      </a>
    ))}
  </div>

  <h3 class="mt-2.5 font-semibold text-ink text-pretty">{incident.title}</h3>

  {incident.description && <p class="mt-1.5 text-sm leading-relaxed whitespace-pre-line text-ink-2">{stripHtml(incident.description)}</p>}

  <dl class="mt-3 flex flex-wrap gap-x-5 gap-y-1 text-xs text-ink-3">
    <div class="flex gap-1.5">
      <dt class="font-semibold text-ink-2">{tr('incident.dates')}</dt>
      <dd>{incidentDateRange(incident, locale)}</dd>
    </div>
    {cause && (
      <div class="flex gap-1.5">
        <dt class="font-semibold text-ink-2">{tr('incident.cause')}</dt>
        <dd>{cause}</dd>
      </div>
    )}
    {effect && (
      <div class="flex gap-1.5">
        <dt class="font-semibold text-ink-2">{tr('incident.effect')}</dt>
        <dd>{effect}</dd>
      </div>
    )}
    {publishedLabel && (
      <div class="flex gap-1.5">
        <dt class="sr-only">{tr('incident.publishedSr')}</dt>
        <dd>{t(locale, 'incident.published', { date: publishedLabel })}</dd>
      </div>
    )}
  </dl>

  {
    docUrl && (
      <a
        href={docUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="mt-3 inline-block rounded-md border border-control-edge bg-surface px-3 py-1.5 text-xs font-semibold text-ink shadow-xs transition hover:bg-surface-2 active:bg-surface-2 focus-ring"
      >
        {tr('incident.pdfLink')}<span aria-hidden="true"> ↗</span>
      </a>
    )
  }
</li>
