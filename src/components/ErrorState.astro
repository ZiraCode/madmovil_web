---
// Bloque de estado de error compartido por las páginas de parada/línea (EMT y CRTM):
// 404 (tone neutral, "?"), servicio caído 503 (warn, "!") y 502 genérico (danger, "!").
// Antes de la Fase 8 había 4 copias casi idénticas con textos ligeramente distintos; los
// textos ahora llegan YA TRADUCIDOS desde la página (t() del locale activo) y el componente
// solo decide la piel. El botón Reintentar recarga la página (aquí mismo, antes era un script
// por página). `action.path` es una ruta INTERNA: el componente le antepone el prefijo /en.
interface Props {
  tone: 'neutral' | 'warn' | 'danger';
  title: string;
  body: string;
  retry?: boolean;
  action?: { path: string; label: string };
}

import { href, t } from '../lib/i18n';

const { tone, title, body, retry = false, action } = Astro.props;
const locale = Astro.locals.locale ?? 'es';

const isNeutral = tone === 'neutral';

const container = isNeutral
  ? 'rounded-xl border border-line bg-surface px-6 py-12 text-center shadow-xs'
  : tone === 'warn'
    ? 'rounded-xl border border-warn bg-warn-soft px-6 py-12 text-center shadow-xs'
    : 'rounded-xl border border-danger bg-danger-soft px-6 py-12 text-center shadow-xs';

const icon = isNeutral ? '?' : '!';
const iconCls = isNeutral
  ? 'bg-surface-2 text-ink-3'
  : tone === 'warn'
    ? 'bg-warn text-page'
    : 'bg-danger text-page';

const titleCls = isNeutral ? 'text-ink' : tone === 'warn' ? 'text-warn-ink' : 'text-danger-ink';
const bodyCls = isNeutral ? 'text-ink-3' : tone === 'warn' ? 'font-medium text-warn-ink/85' : 'font-medium text-danger-ink/85';

// Acción sola → botón primario (marca); junto a Reintentar → secundaria (borde)
const actionCls = retry
  ? 'rounded-xl border border-control-edge bg-surface px-5 py-3 font-semibold text-ink shadow-xs transition hover:bg-surface-2 focus-ring'
  : 'rounded-xl bg-brand px-5 py-3 font-semibold text-on-brand shadow-xs transition hover:bg-brand-hover active:bg-brand-active focus-ring';
---

<section class={container} role={isNeutral ? undefined : 'alert'}>
  <p class:list={['mx-auto grid size-12 place-items-center rounded-full text-xl font-bold', iconCls]} aria-hidden="true">
    {icon}
  </p>
  <h1 class:list={['mt-4 text-xl font-bold tracking-tight', titleCls]}>{title}</h1>
  <p class:list={['mx-auto mt-2 max-w-sm text-sm text-pretty', bodyCls]}>{body}</p>
  {
    (retry || action) && (
      <div class:list={[retry && action ? 'mt-6 flex flex-wrap justify-center gap-2' : 'mt-6']}>
        {retry && (
          <button
            type="button"
            id="retry-btn"
            class="rounded-xl bg-brand px-5 py-3 font-semibold text-on-brand shadow-xs transition hover:bg-brand-hover active:bg-brand-active focus-ring"
          >
            {t(locale, 'error.retry')}
          </button>
        )}
        {action && (
          <a href={href(action.path, locale)} class={actionCls}>
            {action.label}
          </a>
        )}
      </div>
    )
  }
</section>

<script>
  document.getElementById('retry-btn')?.addEventListener('click', () => window.location.reload());
</script>
