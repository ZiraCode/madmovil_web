---
import Layout from '../layouts/Layout.astro';
import { href, translator } from '../lib/i18n';

// Contenido compartido de la página "no encontrada": la usan la /404 prerenderizada
// (ES y EN, cada una con su locale) y el catch-all SSR [...slug] (locale por URL)
const locale = Astro.locals.locale ?? 'es';
const tr = translator(locale);
---

<Layout title={tr('notFound.title')}>
  <section class="mx-auto max-w-md py-10 text-center">
    <p class="text-6xl font-bold tracking-tight text-brand" aria-hidden="true">404</p>
    <h1 class="mt-3 text-2xl font-bold tracking-tight">{tr('notFound.heading')}</h1>
    <p class="mt-2 text-ink-2 text-pretty">
      {tr('notFound.body')}
    </p>
    <div class="mt-6 flex flex-wrap items-center justify-center gap-2">
      <a
        href={href('/', locale)}
        class="rounded-md bg-brand px-5 py-2.5 font-semibold text-on-brand shadow-xs transition hover:bg-brand-hover active:bg-brand-active focus-ring">{tr('common.searchStops')}</a
      >
      <a
        href={href('/mapa', locale)}
        class="rounded-md border border-control-edge bg-surface px-5 py-2.5 font-semibold text-ink shadow-xs transition hover:bg-surface-2 active:bg-surface-2 focus-ring">{tr('common.viewMap')}</a
      >
    </div>
  </section>
</Layout>
