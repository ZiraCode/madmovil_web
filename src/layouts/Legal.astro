---
import Layout from './Layout.astro';
import { t } from '../lib/i18n';

interface Props {
  title: string;
  updated: string;
}

// El locale lo trae locals (middleware por URL en SSR/build; los wrappers EN lo fijan
// ellos mismos para no depender de que el middleware corra en el prerender)
const locale = Astro.locals.locale ?? 'es';
const { title, updated } = Astro.props;
---

<Layout title={title} description={t(locale, 'legal.description', { title: title.toLowerCase() })}>
  <article class="legal">
    <h1>{title}</h1>
    <p class="updated">{t(locale, 'legal.updated', { date: updated })}</p>
    {
      locale === 'en' && (
        <p class="lang-note">{t(locale, 'legal.langNote')}</p>
      )
    }
    <slot />
  </article>
</Layout>

<style is:global>
  .legal {
    font-size: 0.9375rem;
    line-height: 1.65;
    color: var(--color-ink-2, #5b544c);
  }

  .legal h1 {
    font-size: 1.5rem;
    line-height: 1.25;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-ink, #26221e);
  }

  .legal .updated {
    margin-top: 0.25rem;
    font-size: 0.8125rem;
    color: var(--color-ink-3, #8a8074);
  }

  /* Nota de prevalencia de la traducción EN (solo se pinta en /en) */
  .legal .lang-note {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--color-ink-3, #8a8074);
  }

  .legal h2 {
    margin-top: 2rem;
    margin-bottom: 0.5rem;
    font-size: 1.0625rem;
    font-weight: 700;
    color: var(--color-ink, #26221e);
  }

  .legal h3 {
    margin-top: 1.5rem;
    margin-bottom: 0.375rem;
    font-size: 0.9375rem;
    font-weight: 600;
    color: var(--color-ink, #26221e);
  }

  .legal p {
    margin-top: 0.75rem;
  }

  .legal ul,
  .legal ol {
    margin-top: 0.75rem;
    padding-left: 1.25rem;
    list-style: disc;
  }

  .legal ol {
    list-style: decimal;
  }

  .legal li {
    margin-top: 0.375rem;
    padding-left: 0.25rem;
  }

  .legal li::marker {
    color: var(--color-ink-3, #8a8074);
  }

  .legal a {
    color: var(--color-brand-ink, #6d3a20);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .legal a:hover {
    color: var(--color-brand, #8a4a2b);
  }

  .legal a:focus-visible {
    outline: 2px solid var(--color-brand, #8a4a2b);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .legal code {
    font-size: 0.85em;
    background: var(--color-surface-2, #efe9e0);
    border-radius: 4px;
    padding: 0.1em 0.35em;
  }

  .legal strong {
    color: var(--color-ink, #26221e);
    font-weight: 600;
  }
</style>
