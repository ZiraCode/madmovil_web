{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-16",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "madmovil_web",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"workers_dev": false,
	"preview_urls": false,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"cache": {
		"enabled": true
	},
	"observability": {
		"enabled": true
	},
	"ratelimits": [
		{
			"name": "WEB_RATE_LIMITER",
			"namespace_id": "2001",
			"simple": {
				"limit": 120,
				"period": 60
			}
		}
	]
}